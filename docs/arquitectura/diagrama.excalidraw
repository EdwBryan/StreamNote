": 780.0, "height": 145.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": ["etq02"], "frameId": null, "roundness": {"type": 3}, "seed": 1343, "version": 1, "versionNonce": 17459, "isDeleted": false, "boundElements": [], "updated": 1794700000000, "link": null, "locked": false}, {"id": "v8-0049", "type": "text", "x": 4847.5, "y": -436.25, "width": 553.78, "height": 67.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["etq02"], "frameId": null, "roundness": null, "seed": 1350, "version": 1, "versionNonce": 17550, "isDeleted": false, "boundElements": [], "updated": 1794700000000, "link": null, "locked": false, "text": "Amazon S3: guarda los archivos de la web. Es\nprivado: solo CloudFront puede leerlo (OAC).", "originalText": "Amazon S3: guarda los archivos de la web. Es\nprivado: solo CloudFront puede leerlo (OAC).", "fontSize": 27.0, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "v8-0050", "type": "rectangle", "x": 4675.0, "y": -295.0, "width": 125.0, "height": 125.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["etq03"], "frameId": null, "roundness": {"type": 3}, "seed": 1357, "version": 1, "versionNonce": 17641, "isDeleted": false, "boundElements": [], "updated": 1794700000000, "link": null, "locked": false}, {"id": "v8-0051", "type": "text", "x": 4722.5, "y": -264.0, "width": 30.0, "height": 62.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["etq03"], "fra